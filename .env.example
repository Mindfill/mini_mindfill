# ── TECHCESS / mindfill — frontend environment ───────────────────────────────
# Copy to .env.local for local dev, and set the same keys in Vercel for prod.
# All VITE_* vars are embedded in the client bundle (public — no secrets here).

# Supabase project (anon/public key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# FastAPI backend (defaults to the Render URL if unset)
VITE_BACKEND_URL=https://mindfill-api.onrender.com

# Google Identity Services client id (public; Google Cloud Console → OAuth client).
# Authorized JS origins must include your app origin (https://techcess.vercel.app,
# http://localhost:5000) or the GIS button won't render.
VITE_GOOGLE_CLIENT_ID=172484723922-c6vfqml9tl0832cqlau5rug6ttdb8om8.apps.googleusercontent.com
